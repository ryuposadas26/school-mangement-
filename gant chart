const DAY_MS = 86400000;
const dayWidth = 30;
const rowHeight = 44;
const labelWidth = 240;

const toDate = (s) => new Date(s + "T00:00:00");
const fmtShort = (d) => d.toLocaleDateString("en-US", { month: "short", day: "numeric" });
const iso = (d) => d.toISOString().slice(0, 10);
const addDays = (d, n) => new Date(d.getTime() + n * DAY_MS);
const diffDays = (a, b) => Math.round((b.getTime() - a.getTime()) / DAY_MS);
const uid = (p) => p + Date.now().toString(36) + Math.random().toString(36).slice(2, 6);

const TODAY = (() => {
  const d = new Date();
  d.setHours(0, 0, 0, 0);
  return d;
})();

function letterGrade(pct) {
  if (pct >= 90) return "A";
  if (pct >= 80) return "B";
  if (pct >= 70) return "C";
  if (pct >= 60) return "D";
  return "F";
}
function band(pct) {
  if (pct >= 90) return "green";
  if (pct >= 80) return "blue";
  if (pct >= 70) return "amber";
  return "red";
}
function status(a) {
  const due = toDate(a.due);
  if (a.graded) return "graded";
  if (diffDays(due, TODAY) > 0) return "overdue";
  if (diffDays(TODAY, due) === 0) return "dueToday";
  return "upcoming";
}
function weightedPct(list) {
  const graded = list.filter((a) => a.graded && a.counts && a.possible > 0);
  const earned = graded.reduce((s, a) => s + Number(a.earned || 0), 0);
  const possible = graded.reduce((s, a) => s + Number(a.possible || 0), 0);
  return possible > 0 ? (earned / possible) * 100 : null;
}

