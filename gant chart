      <div style={{ fontSize: 11, color: "var(--text-faint)" }}>{sub}</div>
    </div>
  );
}
function Dot({ tone, label }) {
  return (
    <span style={{ display: "inline-flex", alignItems: "center", gap: 5, marginRight: 10 }}>
      <span style={{ width: 9, height: 9, borderRadius: 3, background: `var(--${tone})`, display: "inline-block" }} />
      <span style={S.legendLabel}>{label}</span>
    </span>
  );
}

