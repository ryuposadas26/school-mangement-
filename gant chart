/* ---------------------------------------------------------------- */
/* gantt / timeline view                                             */
/* ---------------------------------------------------------------- */
function GanttView({ assignments, onAdd, onEdit, overdueCount, upcomingCount, trackedPct }) {
  const [filter, setFilter] = useState("all");
  const scrollRef = useRef(null);
  const todayRef = useRef(null);

  const sorted = useMemo(() => [...assignments].sort((a, b) => toDate(a.due) - toDate(b.due)), [assignments]);
  const filtered = useMemo(() => {
    return sorted.filter((a) => {
      if (filter === "all") return true;
      if (filter === "process") return a.category === "Process";
      if (filter === "product") return a.category === "Product";
      const st = status(a);
      if (filter === "overdue") return st === "overdue";
      if (filter === "upcoming") return st === "upcoming" || st === "dueToday";
      if (filter === "done") return st === "graded";
      return true;
    });
  }, [sorted, filter]);

  const { rangeStart, totalDays } = useMemo(() => {
    let min = TODAY,
      max = addDays(TODAY, 7);
    assignments.forEach((a) => {
      const ad = toDate(a.assigned),
        dd = toDate(a.due);
      if (ad < min) min = ad;
      if (dd > max) max = dd;
    });
    const start = addDays(min, -4);
    const end = addDays(max, 6);
    return { rangeStart: start, totalDays: diffDays(start, end) + 1 };
  }, [assignments]);

  const months = useMemo(() => {
    const out = [];
    let cur = null;
    for (let i = 0; i < totalDays; i++) {
      const d = addDays(rangeStart, i);
      const key = d.getMonth() + "-" + d.getFullYear();
      if (!cur || cur.key !== key) {
        cur = { key, label: d.toLocaleDateString("en-US", { month: "long", year: "numeric" }), start: i, span: 1 };
        out.push(cur);
      } else cur.span++;
    }
    return out;
  }, [rangeStart, totalDays]);

  const weekLines = useMemo(() => {
    const out = [];
    for (let i = 0; i < totalDays; i++) {
      const d = addDays(rangeStart, i);
      if (d.getDay() === 1) out.push(i);
    }
    return out;
  }, [rangeStart, totalDays]);

  useEffect(() => {
    if (scrollRef.current && todayRef.current) {
      const left = todayRef.current.offsetLeft - scrollRef.current.clientWidth / 2;
      scrollRef.current.scrollLeft = Math.max(0, left);
    }
  }, [assignments.length]);

  return (
    <div>
      <div style={{ padding: "6px 24px 12px" }}>
        <div style={S.statRow}>
          <Stat label="Tracked average" value={trackedPct == null ? "—" : `${trackedPct.toFixed(1)}%`} sub={trackedPct == null ? "no grades yet" : letterGrade(trackedPct)} tone={trackedPct == null ? null : band(trackedPct)} />
          <Stat label="Overdue" value={overdueCount} sub="need attention" tone="red" icon={overdueCount > 0 ? <AlertTriangle size={13} /> : <CheckCircle2 size={13} />} />
          <Stat label="Upcoming" value={upcomingCount} sub="due soon" tone="amber" icon={<Clock size={13} />} />
        </div>

        <div style={S.controlsRow}>
          <div style={S.legend}>
            <Dot tone="green" label="A" /> <Dot tone="blue" label="B" /> <Dot tone="amber" label="C" /> <Dot tone="red" label="D/F" />
            <span style={{ display: "inline-flex", alignItems: "center", gap: 5, marginLeft: 8 }}>
              <span style={{ width: 12, height: 10, border: "1px solid var(--border-strong)", borderRadius: 3, background: "var(--surface-alt)", display: "inline-block" }} />
              <span style={S.legendLabel}>not graded</span>
            </span>
          </div>
          <div style={{ display: "flex", gap: 10, alignItems: "center" }}>
            <div style={S.filters}>
              {[
                ["all", "All"],
                ["process", "Process"],
                ["product", "Product"],
                ["overdue", "Overdue"],
                ["upcoming", "Upcoming"],
                ["done", "Graded"],
              ].map(([k, label]) => (
                <button key={k} onClick={() => setFilter(k)} type="button" style={{ ...S.filterChip, ...(filter === k ? S.filterChipActive : {}) }}>
                  {label}
                </button>
              ))}
            </div>
            <button style={S.addBtnSmall} onClick={onAdd} type="button">
              <Plus size={14} /> Add
            </button>
          </div>
        </div>
      </div>

      <div ref={scrollRef} style={S.ganttScroll}>
        <div style={{ position: "relative", width: labelWidth + totalDays * dayWidth }}>
          <div style={{ display: "flex", position: "sticky", top: 0, zIndex: 3 }}>
            <div style={S.cornerCell}>Assignment</div>
            <div style={{ position: "relative", width: totalDays * dayWidth, height: 26, background: "var(--surface)", borderBottom: "1px solid var(--border)" }}>
              {months.map((m) => (
                <div key={m.key} style={{ position: "absolute", left: m.start * dayWidth, width: m.span * dayWidth, top: 0, height: 26, display: "flex", alignItems: "center", paddingLeft: 6 }}>
                  <span style={S.monthLabel}>{m.label}</span>
                </div>
              ))}
            </div>
          </div>
          <div style={{ display: "flex", position: "sticky", top: 26, zIndex: 3 }}>
            <div style={{ ...S.cornerCell, height: 22, top: 26, borderTop: "none" }} />
            <div style={{ position: "relative", width: totalDays * dayWidth, height: 22, background: "var(--surface)", borderBottom: "1px solid var(--border)" }}>
              {Array.from({ length: totalDays }).map((_, i) => {
                const d = addDays(rangeStart, i);
                const weekend = d.getDay() === 0 || d.getDay() === 6;
                const isToday = diffDays(d, TODAY) === 0;
                return (
                  <div key={i} ref={isToday ? todayRef : null} style={{ position: "absolute", left: i * dayWidth, width: dayWidth, top: 0, height: 22, textAlign: "center", fontSize: 10.5, color: isToday ? "var(--text)" : weekend ? "var(--text-faint)" : "var(--text-soft)", fontWeight: isToday ? 700 : 400 }}>
                    {d.getDate()}
                  </div>
                );
              })}
              {weekLines.map((i) => (
                <div key={i} style={{ position: "absolute", left: i * dayWidth, top: 0, bottom: -2000, width: 0, borderLeft: "1px solid var(--border)" }} />
              ))}
            </div>
          </div>

          {filtered.map((a, idx) => {
            const st = status(a);
            const left = diffDays(rangeStart, toDate(a.assigned)) * dayWidth;
            const width = Math.max((diffDays(toDate(a.assigned), toDate(a.due)) + 1) * dayWidth - 5, dayWidth - 5);
            const graded = a.graded;
            const pct = graded && a.possible > 0 ? (a.earned / a.possible) * 100 : null;
            const tone = pct != null ? band(pct) : null;
            return (
              <div key={a.id} style={{ display: "flex", background: idx % 2 ? "var(--surface-alt)" : "var(--surface)" }}>
                <div style={S.labelCell} onClick={() => onEdit(a)}>
                  <div style={S.labelName}>{a.name}</div>
                  <div style={S.labelMeta}>
                    <span style={{ ...S.tag, color: a.category === "Process" ? "var(--blue)" : "var(--amber)" }}>{a.category}</span>
                    {!a.counts && <span style={S.tagMuted}>not counted</span>}
                    {st === "overdue" && <span style={{ ...S.tag, color: "var(--red)" }}>overdue</span>}
                  </div>
                </div>
                <div style={{ position: "relative", width: totalDays * dayWidth, height: rowHeight }}>
                  {Array.from({ length: totalDays }).map((_, i) => {
                    const d = addDays(rangeStart, i);
                    if (d.getDay() !== 0 && d.getDay() !== 6) return null;
                    return <div key={i} style={{ position: "absolute", left: i * dayWidth, width: dayWidth, top: 0, bottom: 0, background: "var(--weekend)" }} />;
                  })}
                  <div style={{ position: "absolute", left: diffDays(rangeStart, TODAY) * dayWidth + dayWidth / 2, top: 0, bottom: 0, width: 0, borderLeft: "1.5px solid var(--text)", opacity: 0.35 }} />
                  <div
                    onClick={() => onEdit(a)}
                    title={`${a.name}: ${fmtShort(toDate(a.assigned))} \u2192 ${fmtShort(toDate(a.due))}`}
                    style={{
                      position: "absolute",
                      left,
                      width,
                      top: rowHeight / 2 - 12,
                      height: 24,
                      borderRadius: 6,
                      cursor: "pointer",
                      display: "flex",
                      alignItems: "center",
                      justifyContent: width > 46 ? "flex-start" : "center",
                      padding: "0 9px",
                      fontSize: 12,
                      fontWeight: 600,
                      boxSizing: "border-box",
                      ...(graded
                        ? { background: `var(--${tone}-bg)`, color: `var(--${tone})`, borderLeft: `3px solid var(--${tone})` }
                        : st === "overdue"
                        ? { background: "var(--red-bg)", color: "var(--red)", borderLeft: "3px solid var(--red)" }
                        : { background: "var(--surface-alt)", border: "1px solid var(--border-strong)", color: "var(--text-soft)" }),
                    }}
                  >
                    {graded ? `${pct.toFixed(0)}%` : width > 60 ? (st === "overdue" ? "Overdue" : "Not yet") : ""}
                  </div>
                </div>
              </div>
            );
          })}
          {filtered.length === 0 && <div style={{ padding: 24, color: "var(--text-soft)", fontSize: 13 }}>Nothing here yet — try a different filter, or add an assignment.</div>}
        </div>
      </div>
    </div>
  );
}

/* ---------------------------------------------------------------- */
/* grade simulator                                                    */
/* ---------------------------------------------------------------- */
function SimulatorView({ cls, assignments, onUpdateClass }) {
  const currentPct = cls.officialPct !== null && cls.officialPct !== undefined ? cls.officialPct : weightedPct(assignments);
  const [assumedTotal, setAssumedTotal] = useState(cls.assumedTotal || 200);
  const [included, setIncluded] = useState({});
  const [hyp, setHyp] = useState({});
  const [adhoc, setAdhoc] = useState([]);
  const [adhocForm, setAdhocForm] = useState({ name: "", possible: 10, earned: "" });

  useEffect(() => {
    setAssumedTotal(cls.assumedTotal || 200);
  }, [cls.id]);

  function commitAssumedTotal(v) {
    const n = Number(v) || 1;
    setAssumedTotal(n);
    onUpdateClass({ assumedTotal: n });
  }

  const pending = assignments.filter((a) => status(a) !== "graded");

  const baselinePossible = assumedTotal;
  const baselineEarned = currentPct !== null ? (currentPct / 100) * assumedTotal : 0;

  let simEarned = 0;
  let simPossible = 0;
  pending.forEach((a) => {
    if (included[a.id]) {
      const h = hyp[a.id];
      const e = h === undefined || h === "" ? a.possible : Number(h);
      simEarned += e;
      simPossible += Number(a.possible) || 0;
    }
  });
  adhoc.forEach((item) => {
    simEarned += Number(item.earned) || 0;
    simPossible += Number(item.possible) || 0;
  });

  const projectedPct = baselinePossible + simPossible > 0 ? ((baselineEarned + simEarned) / (baselinePossible + simPossible)) * 100 : null;
  const delta = projectedPct !== null && currentPct !== null ? projectedPct - currentPct : null;

  function addAdhoc(e) {
    e.preventDefault();
    if (!adhocForm.name.trim() || !adhocForm.possible) return;
    setAdhoc((prev) => [...prev, { id: uid("wh"), name: adhocForm.name, possible: Number(adhocForm.possible), earned: Number(adhocForm.earned) || 0 }]);
    setAdhocForm({ name: "", possible: 10, earned: "" });
  }
  function removeAdhoc(id) {
    setAdhoc((prev) => prev.filter((i) => i.id !== id));
  }

  return (
    <div style={{ padding: "6px 24px 28px" }}>
      <div style={S.simGrid}>
        <div style={S.simResultCard}>
          <div style={S.simResultLabel}>Current</div>
          <div style={{ fontSize: 30, fontWeight: 700, fontFamily: "'Source Serif 4', serif", color: currentPct !== null ? `var(--${band(currentPct)})` : "var(--text-faint)" }}>{currentPct !== null ? `${currentPct.toFixed(1)}%` : "—"}</div>
          <div style={S.simResultSub}>{currentPct !== null ? letterGrade(currentPct) : "no grade yet"}</div>
        </div>
        <div style={{ display: "flex", alignItems: "center", color: "var(--text-faint)", fontSize: 20 }}>→</div>
        <div style={S.simResultCard}>
          <div style={S.simResultLabel}>Projected</div>
          <div style={{ fontSize: 30, fontWeight: 700, fontFamily: "'Source Serif 4', serif", color: projectedPct !== null ? `var(--${band(projectedPct)})` : "var(--text-faint)" }}>{projectedPct !== null ? `${projectedPct.toFixed(1)}%` : "—"}</div>
          <div style={S.simResultSub}>
            {projectedPct !== null ? letterGrade(projectedPct) : ""}
            {delta !== null && delta !== 0 ? <span style={{ color: delta > 0 ? "var(--green)" : "var(--red)" }}> {delta > 0 ? "+" : ""}{delta.toFixed(1)}%</span> : null}
          </div>
        </div>
      </div>

      <div style={{ marginTop: 4, marginBottom: 18 }}>
        <label style={S.label}>Assumed total points so far</label>
        <input style={{ ...S.input, maxWidth: 160 }} type="number" min="1" value={assumedTotal} onChange={(e) => commitAssumedTotal(e.target.value)} />
        <div style={S.hint}>This turns your current % into a points pool so new work can shift it proportionally. Match it to your gradebook's real total for the most accurate projection.</div>
      </div>

      <h3 style={S.simSectionTitle}>Not-yet-graded assignments</h3>
      {pending.length === 0 && <div style={{ color: "var(--text-soft)", fontSize: 13, marginBottom: 8 }}>Everything tracked here is already graded. Add a what-if below to test something new.</div>}
      <div style={{ display: "flex", flexDirection: "column", gap: 8, marginBottom: 20 }}>
        {pending.map((a) => (
          <div key={a.id} style={S.simRow}>
            <label style={{ display: "flex", alignItems: "center", gap: 8, flex: 1, minWidth: 0 }}>
              <input type="checkbox" checked={!!included[a.id]} onChange={(e) => setIncluded({ ...included, [a.id]: e.target.checked })} />
              <span style={{ overflow: "hidden", textOverflow: "ellipsis", whiteSpace: "nowrap", fontSize: 13 }}>{a.name}</span>
            </label>
            <span style={{ fontSize: 11.5, color: "var(--text-soft)", whiteSpace: "nowrap" }}>due {fmtShort(toDate(a.due))}</span>
            <input
              type="number"
              min="0"
              step="0.5"
              max={a.possible}
              disabled={!included[a.id]}
              value={hyp[a.id] === undefined ? "" : hyp[a.id]}
              onChange={(e) => setHyp({ ...hyp, [a.id]: e.target.value })}
              placeholder={String(a.possible)}
              style={{ ...S.input, width: 64, padding: "5px 6px", opacity: included[a.id] ? 1 : 0.5 }}
            />
            <span style={{ fontSize: 12, color: "var(--text-faint)" }}>/ {a.possible}</span>
          </div>
        ))}
      </div>

      <h3 style={S.simSectionTitle}>What-if: score not yet on the tracker</h3>
      <form onSubmit={addAdhoc} style={{ display: "flex", gap: 8, flexWrap: "wrap", alignItems: "flex-end", marginBottom: 14 }}>
        <div style={{ flex: 2, minWidth: 140 }}>
          <label style={S.label}>Assignment</label>
          <input style={S.input} value={adhocForm.name} onChange={(e) => setAdhocForm({ ...adhocForm, name: e.target.value })} placeholder="e.g. Unit test" />
        </div>
        <div style={{ width: 80 }}>
          <label style={S.label}>Possible</label>
          <input style={S.input} type="number" min="0" step="0.5" value={adhocForm.possible} onChange={(e) => setAdhocForm({ ...adhocForm, possible: e.target.value })} />
        </div>
        <div style={{ width: 80 }}>
          <label style={S.label}>Earned</label>
          <input style={S.input} type="number" min="0" step="0.5" value={adhocForm.earned} onChange={(e) => setAdhocForm({ ...adhocForm, earned: e.target.value })} placeholder="0" />
        </div>
        <button type="submit" style={S.addBtnSmall}>
          <Plus size={14} /> Add
        </button>
      </form>
      {adhoc.length > 0 && (
        <div style={{ display: "flex", flexDirection: "column", gap: 6 }}>
          {adhoc.map((item) => (
            <div key={item.id} style={S.simRow}>
              <span style={{ flex: 1, fontSize: 13 }}>{item.name}</span>
              <span style={{ fontSize: 12, color: "var(--text-soft)" }}>
                {item.earned} / {item.possible}
              </span>
              <button type="button" onClick={() => removeAdhoc(item.id)} style={S.iconBtn}>
                <X size={14} />
              </button>
            </div>
          ))}
        </div>
      )}
    </div>
  );
}

/* ---------------------------------------------------------------- */
/* small shared components                                           */
/* ---------------------------------------------------------------- */
function Stat({ label, value, sub, tone, icon }) {
