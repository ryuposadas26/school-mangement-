        else {
          setClasses(SEED_CLASSES);
          await window.storage.set("classes", JSON.stringify(SEED_CLASSES));
        }
      } catch (e) {
        setClasses(SEED_CLASSES);
        try {
          await window.storage.set("classes", JSON.stringify(SEED_CLASSES));
        } catch (_) {}
      }
      try {
        const res = await window.storage.get("assignments");
        if (res && res.value) setAssignments(JSON.parse(res.value));
        else {
          setAssignments(SEED_ASSIGNMENTS);
          await window.storage.set("assignments", JSON.stringify(SEED_ASSIGNMENTS));
        }
      } catch (e) {
        setAssignments(SEED_ASSIGNMENTS);
        try {
          await window.storage.set("assignments", JSON.stringify(SEED_ASSIGNMENTS));
        } catch (_) {}
      }
      try {
        const t = await window.storage.get("theme");
        if (t && t.value) setTheme(t.value);
      } catch (_) {}
      setLoaded(true);
    })();
  }, []);

  useEffect(() => {
    if (!loaded) return;
    (async () => {
      try {
        await window.storage.set("classes", JSON.stringify(classes));
      } catch (e) {
        console.error("save classes failed", e);
      }
    })();
  }, [classes, loaded]);

  useEffect(() => {
    if (!loaded) return;
    (async () => {
      try {
        await window.storage.set("assignments", JSON.stringify(assignments));
      } catch (e) {
        console.error("save assignments failed", e);
      }
    })();
  }, [assignments, loaded]);

  useEffect(() => {
    if (!loaded) return;
    (async () => {
      try {
        await window.storage.set("theme", theme);
      } catch (_) {}
    })();
  }, [theme, loaded]);

  const selectedClass = classes.find((c) => c.id === selectedClassId) || null;
  const classAssignments = useMemo(() => assignments.filter((a) => a.classId === selectedClassId), [assignments, selectedClassId]);

  /* ---- class nav ---- */
  function openClass(id) {
    setSelectedClassId(id);
    setClassTab("timeline");
    setView("class");
  }
  function goHome() {
    setView("home");
    setSelectedClassId(null);
  }

  /* ---- class modal ---- */
  function openAddClass() {
    setEditingClassId(null);
    setClassForm(emptyClassForm);
    setClassModalOpen(true);
  }
  function openEditClass(c) {
    setEditingClassId(c.id);
    setClassForm({ ...c, officialPct: c.officialPct === null ? "" : c.officialPct });
    setClassModalOpen(true);
  }
  function closeClassModal() {
    setClassModalOpen(false);
    setEditingClassId(null);
  }
  function saveClassForm(e) {
    e.preventDefault();
    if (!classForm.name.trim()) return;
    const clean = {
      ...classForm,
      officialPct: classForm.officialPct === "" ? null : Number(classForm.officialPct),
      officialMissing: Number(classForm.officialMissing) || 0,
      assumedTotal: Number(classForm.assumedTotal) || 200,
    };
    if (editingClassId) {
      setClasses((prev) => prev.map((c) => (c.id === editingClassId ? { ...clean, id: editingClassId } : c)));
    } else {
      const id = uid("c");
      setClasses((prev) => [...prev, { ...clean, id }]);
    }
    closeClassModal();
  }
  function removeClass(id) {
    setClasses((prev) => prev.filter((c) => c.id !== id));
    setAssignments((prev) => prev.filter((a) => a.classId !== id));
    closeClassModal();
    if (selectedClassId === id) goHome();
  }

  /* ---- assignment modal ---- */
  function openAddAssignment() {
    setEditingAssignId(null);
    setAssignForm(emptyForm);
    setAssignModalOpen(true);
  }
  function openEditAssignment(a) {
    setEditingAssignId(a.id);
    setAssignForm({ ...a, earned: a.earned === 0 && !a.graded ? "" : a.earned });
    setAssignModalOpen(true);
  }
  function closeAssignModal() {
    setAssignModalOpen(false);
    setEditingAssignId(null);
  }
  function saveAssignForm(e) {
    e.preventDefault();
    if (!assignForm.name.trim() || !assignForm.due) return;
    const clean = { ...assignForm, possible: Number(assignForm.possible) || 0, earned: assignForm.graded ? Number(assignForm.earned) || 0 : 0, classId: selectedClassId };
    if (editingAssignId) setAssignments((prev) => prev.map((a) => (a.id === editingAssignId ? { ...clean, id: editingAssignId } : a)));
    else setAssignments((prev) => [...prev, { ...clean, id: uid("id") }]);
    closeAssignModal();
  }
  function removeAssignment(id) {
    setAssignments((prev) => prev.filter((a) => a.id !== id));
    closeAssignModal();
  }

  if (!loaded) {
    return (
      <div className="at-root" data-theme={theme} style={{ ...S.board, display: "flex", alignItems: "center", justifyContent: "center", minHeight: 300 }}>
        <style>{CSS_VARS}</style>
        <div style={{ color: "var(--text-soft)", fontSize: 14 }}>Loading your classes…</div>
      </div>
    );
  }

  return (
    <div className="at-root" data-theme={theme} style={S.board}>
      <style>{CSS_VARS}</style>

      {view === "home" && (
        <HomeView classes={classes} assignments={assignments} theme={theme} setTheme={setTheme} onOpenClass={openClass} onAddClass={openAddClass} onEditClass={openEditClass} />
      )}

      {view === "class" && selectedClass && (
        <ClassView
          cls={selectedClass}
          assignments={classAssignments}
          theme={theme}
          setTheme={setTheme}
          tab={classTab}
          setTab={setClassTab}
          onBack={goHome}
          onEditClass={() => openEditClass(selectedClass)}
          onAddAssignment={openAddAssignment}
          onEditAssignment={openEditAssignment}
          onUpdateClass={(patch) => setClasses((prev) => prev.map((c) => (c.id === selectedClass.id ? { ...c, ...patch } : c)))}
        />
      )}

      {/* assignment modal */}
      {assignModalOpen && (
        <div style={S.overlay} onClick={closeAssignModal}>
          <form style={S.modal} onClick={(e) => e.stopPropagation()} onSubmit={saveAssignForm}>
            <div style={{ display: "flex", justifyContent: "space-between", alignItems: "center", marginBottom: 16 }}>
              <h2 style={S.modalTitle}>{editingAssignId ? "Edit assignment" : "New assignment"}</h2>
              <button type="button" onClick={closeAssignModal} style={S.iconBtn}>
                <X size={18} />
              </button>
            </div>

            <label style={S.label}>Name</label>
            <input style={S.input} value={assignForm.name} onChange={(e) => setAssignForm({ ...assignForm, name: e.target.value })} placeholder="e.g. Chapter 4 Reading Notes" required />

            <div style={S.formRow}>
              <div style={{ flex: 1 }}>
                <label style={S.label}>Category</label>
                <select style={S.input} value={assignForm.category} onChange={(e) => setAssignForm({ ...assignForm, category: e.target.value })}>
                  <option>Process</option>
                  <option>Product</option>
                </select>
              </div>
              <div style={{ flex: 1 }}>
                <label style={S.label}>Points possible</label>
                <input style={S.input} type="number" min="0" step="0.5" value={assignForm.possible} onChange={(e) => setAssignForm({ ...assignForm, possible: e.target.value })} />
              </div>
            </div>

            <div style={S.formRow}>
              <div style={{ flex: 1 }}>
                <label style={S.label}>Date assigned</label>
                <input style={S.input} type="date" value={assignForm.assigned} onChange={(e) => setAssignForm({ ...assignForm, assigned: e.target.value })} required />
              </div>
              <div style={{ flex: 1 }}>
                <label style={S.label}>Due date</label>
                <input style={S.input} type="date" value={assignForm.due} onChange={(e) => setAssignForm({ ...assignForm, due: e.target.value })} required />
              </div>
            </div>

            <div style={S.formRow}>
              <label style={{ ...S.checkRow, flex: 1 }}>
                <input type="checkbox" checked={assignForm.graded} onChange={(e) => setAssignForm({ ...assignForm, graded: e.target.checked })} /> Graded already
              </label>
              <label style={{ ...S.checkRow, flex: 1 }}>
                <input type="checkbox" checked={assignForm.counts} onChange={(e) => setAssignForm({ ...assignForm, counts: e.target.checked })} /> Counts toward grade
              </label>
            </div>

            {assignForm.graded && (
              <>
                <label style={S.label}>Points earned</label>
                <input style={S.input} type="number" min="0" step="0.5" value={assignForm.earned} onChange={(e) => setAssignForm({ ...assignForm, earned: e.target.value })} />
              </>
            )}

            <label style={S.label}>Notes (optional)</label>
            <textarea style={{ ...S.input, minHeight: 54, resize: "vertical" }} value={assignForm.notes} onChange={(e) => setAssignForm({ ...assignForm, notes: e.target.value })} placeholder="What does this actually involve?" />

            <div style={{ display: "flex", justifyContent: "space-between", marginTop: 18 }}>
              {editingAssignId ? (
                <button type="button" onClick={() => removeAssignment(editingAssignId)} style={S.deleteBtn}>
                  <Trash2 size={14} /> Delete
                </button>
              ) : (
                <span />
              )}
              <div style={{ display: "flex", gap: 8 }}>
                <button type="button" onClick={closeAssignModal} style={S.cancelBtn}>
                  Cancel
                </button>
                <button type="submit" style={S.saveBtn}>
                  {editingAssignId ? "Save changes" : "Add assignment"}
                </button>
              </div>
            </div>
          </form>
        </div>
      )}

      {/* class modal */}
      {classModalOpen && (
        <div style={S.overlay} onClick={closeClassModal}>
          <form style={S.modal} onClick={(e) => e.stopPropagation()} onSubmit={saveClassForm}>
            <div style={{ display: "flex", justifyContent: "space-between", alignItems: "center", marginBottom: 16 }}>
              <h2 style={S.modalTitle}>{editingClassId ? "Edit class" : "New class"}</h2>
              <button type="button" onClick={closeClassModal} style={S.iconBtn}>
                <X size={18} />
              </button>
            </div>

            <label style={S.label}>Class name</label>
            <input style={S.input} value={classForm.name} onChange={(e) => setClassForm({ ...classForm, name: e.target.value })} placeholder="e.g. Biology 2 - Fall" required />

            <div style={S.formRow}>
              <div style={{ flex: 1 }}>
                <label style={S.label}>Teacher</label>
                <input style={S.input} value={classForm.teacher} onChange={(e) => setClassForm({ ...classForm, teacher: e.target.value })} placeholder="Last, First" />
              </div>
              <div style={{ flex: 1 }}>
                <label style={S.label}>Room</label>
                <input style={S.input} value={classForm.room} onChange={(e) => setClassForm({ ...classForm, room: e.target.value })} placeholder="e.g. E132" />
              </div>
            </div>

            <label style={S.label}>Website</label>
            <input style={S.input} value={classForm.website} onChange={(e) => setClassForm({ ...classForm, website: e.target.value })} placeholder="https://…" />

            <label style={S.label}>Access code</label>
            <input style={S.input} value={classForm.accessCode} onChange={(e) => setClassForm({ ...classForm, accessCode: e.target.value })} placeholder="e.g. g7u6cifz" />

            <div style={S.formRow}>
              <div style={{ flex: 1 }}>
                <label style={S.label}>Current grade % (from gradebook)</label>
                <input style={S.input} type="number" min="0" max="100" step="0.1" value={classForm.officialPct} onChange={(e) => setClassForm({ ...classForm, officialPct: e.target.value })} placeholder="e.g. 84.5" />
              </div>
              <div style={{ flex: 1 }}>
                <label style={S.label}>Missing (per gradebook)</label>
                <input style={S.input} type="number" min="0" step="1" value={classForm.officialMissing} onChange={(e) => setClassForm({ ...classForm, officialMissing: e.target.value })} />
              </div>
            </div>

            <label style={S.label}>Assumed total points so far</label>
            <input style={S.input} type="number" min="1" step="1" value={classForm.assumedTotal} onChange={(e) => setClassForm({ ...classForm, assumedTotal: e.target.value })} />
            <div style={S.hint}>Used by the grade simulator to translate your current % into an earned/possible points pool. Adjust to match your gradebook's real point total for a more accurate simulation.</div>

            <div style={{ display: "flex", justifyContent: "space-between", marginTop: 18 }}>
              {editingClassId ? (
                <button type="button" onClick={() => removeClass(editingClassId)} style={S.deleteBtn}>
                  <Trash2 size={14} /> Delete class
                </button>
              ) : (
                <span />
              )}
              <div style={{ display: "flex", gap: 8 }}>
                <button type="button" onClick={closeClassModal} style={S.cancelBtn}>
                  Cancel
                </button>
                <button type="submit" style={S.saveBtn}>
                  {editingClassId ? "Save changes" : "Add class"}
                </button>
              </div>
            </div>
          </form>
        </div>
      )}
    </div>
  );
}

/* ---------------------------------------------------------------- */
/* home view                                                          */
/* ---------------------------------------------------------------- */
function HomeView({ classes, assignments, theme, setTheme, onOpenClass, onAddClass, onEditClass }) {
  const gradedPcts = classes.map((c) => c.officialPct).filter((p) => p !== null && p !== undefined);
  const avg = gradedPcts.length ? gradedPcts.reduce((s, p) => s + p, 0) / gradedPcts.length : null;

  return (
    <div>
      <div style={{ padding: "22px 24px 6px", display: "flex", justifyContent: "space-between", alignItems: "flex-start", flexWrap: "wrap", gap: 12 }}>
        <div>
          <h1 style={S.h1}>Your Classes</h1>
          <div style={S.subtitle}>
            {TODAY.toLocaleDateString("en-US", { weekday: "long", month: "long", day: "numeric" })}
            {avg !== null && <> · overall average {avg.toFixed(1)}%</>}
          </div>
        </div>
        <div style={{ display: "flex", gap: 8 }}>
          <button style={S.iconToggle} onClick={() => setTheme(theme === "light" ? "dark" : "light")} type="button" aria-label="Toggle theme">
            {theme === "light" ? <Moon size={16} /> : <Sun size={16} />}
          </button>
          <button style={S.addBtn} onClick={onAddClass} type="button">
            <Plus size={16} strokeWidth={2.25} /> Add class
          </button>
        </div>
      </div>

      <div style={{ padding: "16px 24px 24px", display: "grid", gridTemplateColumns: "repeat(auto-fill, minmax(260px, 1fr))", gap: 14 }}>
        {classes.map((c) => {
          const list = assignments.filter((a) => a.classId === c.id);
          const overdue = list.filter((a) => status(a) === "overdue").length;
          const tracked = weightedPct(list);
          const pct = c.officialPct !== null && c.officialPct !== undefined ? c.officialPct : tracked;
          const tone = pct !== null ? band(pct) : null;
          return (
            <div key={c.id} style={S.classCard} onClick={() => onOpenClass(c.id)}>
              <div style={{ display: "flex", justifyContent: "space-between", alignItems: "flex-start", gap: 10 }}>
                <div>
                  <div style={S.classCardName}>{c.name}</div>
                  <div style={S.classCardMeta}>
                    {c.teacher}
                    {c.room ? `  ${c.room}` : ""}
                  </div>
                </div>
                <div style={{ textAlign: "right" }}>
                  <div style={S.gradeLabel}>Grade</div>
                  <div style={{ fontSize: 24, fontWeight: 700, color: tone ? `var(--${tone})` : "var(--text-faint)", fontFamily: "'Source Serif 4', serif", lineHeight: 1.1 }}>{pct !== null ? letterGrade(pct) : "—"}</div>
                  <div style={S.gradePct}>{pct !== null ? `(${pct.toFixed(1)}%)` : ""}</div>
                </div>
              </div>

              <div style={S.classCardRow}>
                <span style={{ color: "var(--text-soft)" }}>Missing Assignments</span>
                <span style={{ color: c.officialMissing > 0 ? "var(--red)" : "var(--text-faint)", fontWeight: 600 }}>{c.officialMissing}</span>
              </div>
              {overdue > 0 && (
                <div style={S.classCardRow}>
                  <span style={{ color: "var(--text-soft)" }}>Overdue in tracker</span>
                  <span style={{ color: "var(--red)", fontWeight: 600 }}>{overdue}</span>
                </div>
              )}

              <div style={{ ...S.classCardRow, marginTop: 8 }}>
                <span style={{ color: "var(--text-soft)" }}>
                  {c.accessCode ? (
                    <>
                      Access code: <span style={{ color: "var(--text)" }}>{c.accessCode}</span>
                    </>
                  ) : (
                    "No access code"
                  )}
                </span>
                <button
                  type="button"
                  onClick={(e) => {
                    e.stopPropagation();
                    onEditClass(c);
                  }}
                  style={S.cardEditBtn}
                >
                  <Pencil size={12} />
                </button>
              </div>

              <div style={S.classCardFooter}>
                {list.length} tracked assignment{list.length === 1 ? "" : "s"} · updated {c.updated || "—"}
              </div>
